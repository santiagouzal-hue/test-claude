    "custom_css": "@import url('https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap');\n\nhtml, body {\n  overflow: hidden !important;\n  margin: 0;\n  padding: 0;\n  background: #fff;\n}\n\n/* Fullpage scroll snap */\n.elementor-section-wrap {\n  height: 100vh;\n  overflow-y: scroll;\n  scroll-snap-type: y mandatory;\n  -ms-overflow-style: none;\n  scrollbar-width: none;\n}\n.elementor-section-wrap::-webkit-scrollbar {\n  display: none;\n}\n.elementor-top-section {\n  scroll-snap-align: start;\n  scroll-snap-stop: always;\n}\n\n/* Header */\n.baur-header-wrap {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 22px 30px;\n  background: transparent;\n}\n.baur-logo {\n  display: block;\n  line-height: 0;\n}\n.baur-logo svg {\n  fill: #000;\n  width: 90px;\n  height: 33px;\n}\n.baur-nav-right {\n  display: flex;\n  align-items: center;\n  gap: 20px;\n}\n.baur-lang-link {\n  font-family: Roboto, sans-serif;\n  font-size: 13px;\n  color: #000;\n  text-decoration: none;\n  letter-spacing: 0.03em;\n  text-transform: lowercase;\n}\n.baur-hamburger {\n  background: none;\n  border: none;\n  cursor: pointer;\n  padding: 4px;\n  display: flex;\n  flex-direction: column;\n  gap: 5px;\n}\n.baur-hamburger span {\n  display: block;\n  width: 20px;\n  height: 1.5px;\n  background: #000;\n  transition: background 0.3s;\n}\n\n/* Slide text sections */\n.baur-slide-text {\n  display: flex;\n  align-items: center;\n  justify-content: flex-start;\n  height: 100vh;\n  padding: 0 60px;\n}\n.baur-hight {\n  font-family: Roboto, sans-serif;\n  font-size: 40px;\n  font-weight: 400;\n  line-height: 1.35;\n  color: #000;\n  margin: 0;\n  padding: 0;\n}\n\n/* Responsive */\n@media (max-width: 1024px) {\n  .baur-hight {\n    font-size: 32px;\n  }\n}\n@media (max-width: 768px) {\n  .baur-hight {\n    font-size: 24px;\n    line-height: 1.3;\n  }\n  .baur-slide-text {\n    padding: 0 30px;\n  }\n  .baur-header-wrap {\n    padding: 15px 20px;\n  }\n  .baur-logo svg {\n    width: 70px;\n    height: 26px;\n  }\n}"
